Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Logging Plug-in
Bundle-SymbolicName: org.talend.platform.logging
Bundle-Version: 8.9.0.qualifier
Bundle-Activator: org.talend.platform.logging.Activator
Bundle-Vendor: .Talaxie SA.
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.talend.utils,
 org.apache.log4j,
 org.apache.xerces,
 org.apache.commons.lang3
Bundle-ActivationPolicy: lazy
Eclipse-BuddyPolicy: global
Eclipse-RegisterBuddy: org.apache.log4j
Eclipse-BundleShape: dir
Automatic-Module-Name: org.talend.platform.logging

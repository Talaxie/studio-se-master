<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
<extension
      id="product"
      point="org.eclipse.core.runtime.products">
   <product
         application="org.talend.rcp.branding.esbstandard.application"
         name="%productName">
      <property
            name="appName"
            value="%productName">
      </property>
      <property
            name="cssTheme"
            value="org.talend.themes.css.talend.default">
      </property>
      <property
            name="applicationCSSResources"
            value="platform:/plugin/org.talend.themes.css.talend/themes/">
      </property>
      <property
            name="lifeCycleURI"
            value="bundleclass://org.talend.core.ui/org.talend.core.ui.TalendStudioLifeCycleManager">
      </property>
      <property
            name="aboutImage"
            value="platform:/plugin/org.talend.rcp.branding.esbstandard/icons/about.jpg">
      </property>
      <property
            name="aboutText"
            value="%productBlurb">
      </property>
      <property
            name="windowImages"
            value="platform:/plugin/org.talend.rcp/icons/appli_16x16.gif,platform:/plugin/org.talend.rcp/icons/appli_32x32.gif,platform:/plugin/org.talend.rcp/icons/appli_48x48.gif">
      </property>
      <property
            name="startupForegroundColor"
            value="FFFFFF">
      </property>
      <property
            name="startupMessageRect"
            value="12,202,415,22">
      </property>
      <property
            name="startupProgressRect"
            value="12,224,411,14">
      </property>
      <property
            name="preferenceCustomization"
            value="platform:/plugin/org.talend.rcp.branding.esbstandard/plugin_customization.ini">
      </property>      
   </product>
</extension>
      <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="org.talend.rcp.intro.Application">
         </run>
      </application>
   </extension>
         <extension
            point="org.talend.core.runtime.service">
         <Service
               class="org.talend.rcp.branding.esbstandard.EsbSeBrandingService"
               serviceId="org.talend.core.ui.branding.IBrandingService"/>
      </extension>
         <extension
               point="org.eclipse.ui.perspectives">
            <perspective
                  class="org.talend.rcp.perspective.Perspective"
                  icon="platform:/plugin/org.talend.core/icons/process_icon.png"
                  id="org.talend.rcp.perspective"
                  name="Integration">
            </perspective>
         </extension>
         <extension
               point="org.talend.core.talendperspectives">
            <TalendPerspective
                  refPerspectiveId="org.talend.rcp.perspective"
                  talendPerspectiveId="org.talend.rcp.DesignPerspective">
            </TalendPerspective>
         </extension>
         <extension point="org.eclipse.ui.editors">
		   <editor
		         class="org.talend.rcp.branding.esbstandard.starting.EsbStartingBrowser"
		         default="false"
		         id="org.talend.rcp.branding.esbstandard.starting.EsbStartingBrowser"
		         name="starting">
		   </editor>
		</extension>
         <extension
               point="org.eclipse.ui.commands">
            <command
                  id="org.talend.rcp.show.about.command"
                  name="About Talend Studio">
            </command>
         </extension>
         <extension
               point="org.eclipse.ui.views">
            <category
                 id="org.talend.core.root"
                 name="Talend"/>
         </extension>
</plugin>

maven MavenDependencies scope=compile dependencyDepth=infinite missingManifest=generate includeSources {
	feature {
		id="jakarta.api.talaxie"
		name="Jakarta APIs used by Talaxie"
		version="1.0.0"
	}
	dependency {
		groupId="jakarta.xml.bind"
		artifactId="jakarta.xml.bind-api"
		version="4.0.4"
	}
	// legacy javax.inject api for compatibility
	dependency {
		groupId="javax.inject"
		artifactId="javax.inject"
		version="1"
	}
	dependency {
		groupId="com.sun.mail"
		artifactId="jakarta.mail"
		version="2.0.2"
	}
	dependency {
		groupId="jakarta.el"
		artifactId="jakarta.el-api"
		version="6.0.1"
	}
	dependency {
		groupId="jakarta.servlet"
		artifactId="jakarta.servlet-api"
		version="6.1.0"
	}
	dependency {
		groupId="jakarta.servlet.jsp"
		artifactId="jakarta.servlet.jsp-api"
		version="4.0.0"
	}
	dependency {
		groupId="jakarta.transaction"
		artifactId="jakarta.transaction-api"
		version="2.0.1"
	}
	dependency {
	    groupId = "jakarta.enterprise"
	    artifactId = "jakarta.enterprise.cdi-api"
	    version = "4.1.0"
	}
	dependency {
	    groupId = "jakarta.interceptor"
	    artifactId = "jakarta.interceptor-api"
	    version = "2.2.0"
	}
}
maven MavenDependencies scope=compile dependencyDepth=infinite missingManifest=generate includeSources {
	dependency {
		groupId="com.clearspring.analytics"
		artifactId="stream"
		version="2.9.8"
	}
	dependency {
		groupId="jakarta.xml.rpc"
		artifactId="jakarta.xml.rpc-api"
		version="1.1.4"
	}
	dependency {
		groupId="org.apache.avro"
		artifactId="avro"
		version="1.12.1"
	}
	/*
	 * These used to be in a repo such as
	 * https://nexus.deilink.fr/repository/unzip/TalendP2UnzipOpenSourceSnapshot/org/talend/repo/dependencies.p2.tos/8.8.8-SNAPSHOT/dependencies.p2.tos-8.8.8-SNAPSHOT.zip-unzip/
	 * but there is actually no need for such a wrapper repository.
	 * We can take them directly from maven.
	 * dependency {
	 * 	groupId="org.talend.studio"
	 * 	artifactId="studio-utils"
	 * 	version="1.0.14"
	 * }
	 */
	dependency {
		groupId="org.apache.commons"
		artifactId="commons-compress"
		version="1.28.0"
	}
}

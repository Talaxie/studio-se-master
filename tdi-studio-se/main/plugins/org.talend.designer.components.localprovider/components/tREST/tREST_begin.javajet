<%@ jet 
imports="
	org.talend.core.model.process.INode 
	org.talend.core.model.process.ElementParameterParser 
	org.talend.designer.codegen.config.CodeGeneratorArgument
	org.talend.core.model.process.IConnection
	org.talend.core.model.process.IConnectionCategory
	java.util.Map
	java.util.List
	org.talend.core.model.metadata.IMetadataTable
	org.talend.core.model.metadata.IMetadataColumn      
" 
%>
<%@ include file="@{org.talend.designer.components.localprovider}/components/templates/Log4j/LogUtil.javajet"%>

<%
CodeGeneratorArgument codeGenArgument = (CodeGeneratorArgument) argument;
INode node = (INode)codeGenArgument.getArgument();
String cid = node.getUniqueName();
log = new LogUtil(node);

String url = ElementParameterParser.getValue(node, "__URL__");
String method = ElementParameterParser.getValue(node, "__METHOD__");
List<Map<String, String>> headers = (List<Map<String,String>>)ElementParameterParser.getObjectValue(node, "__HEADERS__");

String body = ElementParameterParser.getValue(node, "__BODY__");
body = body.replaceAll("[\r\n]", " ");
%>

String endpoint_<%=cid%> = <%=url%>;

String trustStoreFile_<%=cid%> = System.getProperty("javax.net.ssl.trustStore");
String trustStoreType_<%=cid%> = System.getProperty("javax.net.ssl.trustStoreType");
String trustStorePWD_<%=cid%> = System.getProperty("javax.net.ssl.trustStorePassword");

String keyStoreFile_<%=cid%> = System.getProperty("javax.net.ssl.keyStore");
String keyStoreType_<%=cid%> = System.getProperty("javax.net.ssl.keyStoreType");
String keyStorePWD_<%=cid%> = System.getProperty("javax.net.ssl.keyStorePassword");

java.util.Map<String, String> headers_<%=cid%> = new java.util.HashMap<String, String>();

<%
for (int i = 0; i < headers.size(); i++) {
	Map<String, String> line = headers.get(i);
%>
	headers_<%=cid%>.put(<%= line.get("NAME") %>, <%= line.get("VALUE") %>);
<%
}
%>

if (endpoint_<%=cid%> == null || ("").equals(endpoint_<%=cid%>)) {
	throw new IllegalArgumentException("url can't be empty!");
}

String restResponse_<%=cid%> = "";
int statusCode_<%=cid%> = 200;

try {
	<% log.info(log.str("Prepare to send request to rest server.")); %>

	// Client HTTP natif Java 11+
	java.net.http.HttpClient.Builder clientBuilder_<%=cid%> = java.net.http.HttpClient.newBuilder();

	// Support SSL TrustStore / KeyStore
	if (trustStoreFile_<%=cid%> != null && trustStoreType_<%=cid%> != null) {
		char[] password_<%=cid%> = null;
		if (trustStorePWD_<%=cid%> != null) {
			password_<%=cid%> = trustStorePWD_<%=cid%>.toCharArray();
		}
		java.security.KeyStore trustStore_<%=cid%> = java.security.KeyStore.getInstance(trustStoreType_<%=cid%>);
		trustStore_<%=cid%>.load(new java.io.FileInputStream(trustStoreFile_<%=cid%>), password_<%=cid%>);
		
		javax.net.ssl.TrustManagerFactory tmf_<%=cid%> = javax.net.ssl.TrustManagerFactory.getInstance(javax.net.ssl.KeyManagerFactory.getDefaultAlgorithm());
		tmf_<%=cid%>.init(trustStore_<%=cid%>);
		
		javax.net.ssl.SSLContext sslContext_<%=cid%> = javax.net.ssl.SSLContext.getInstance("TLS");
		sslContext_<%=cid%>.init(null, tmf_<%=cid%>.getTrustManagers(), null);
		clientBuilder_<%=cid%>.sslContext(sslContext_<%=cid%>);
	}

	java.net.http.HttpClient nativeClient_<%=cid%> = clientBuilder_<%=cid%>.build();
	java.net.http.HttpRequest.Builder reqBuilder_<%=cid%> = java.net.http.HttpRequest.newBuilder()
		.uri(java.net.URI.create(endpoint_<%=cid%>));

	// Construction du body pour les méthodes avec payload
	java.net.http.HttpRequest.BodyPublisher bodyPublisher_<%=cid%>;
<%
	if ("POST".equals(method) || "PUT".equals(method) || "PATCH".equals(method)) {
%>
		String requestBody_<%=cid%> = String.valueOf(<%=body%>);
		bodyPublisher_<%=cid%> = java.net.http.HttpRequest.BodyPublishers.ofString(requestBody_<%=cid%>, java.nio.charset.StandardCharsets.UTF_8);

		// Ajout automatique du Content-Type JSON si non spécifié
		if (!headers_<%=cid%>.containsKey("Content-Type") && !headers_<%=cid%>.containsKey("content-type")) {
			reqBuilder_<%=cid%>.header("Content-Type", "application/json");
		}
<%
	} else {
%>
		bodyPublisher_<%=cid%> = java.net.http.HttpRequest.BodyPublishers.noBody();
<%
	}
%>

	// Assignation du verbe HTTP
	reqBuilder_<%=cid%>.method("<%=method%>", bodyPublisher_<%=cid%>);

	// Ajout des en-têtes personnalisés
	for (java.util.Map.Entry<String, String> header_<%=cid%> : headers_<%=cid%>.entrySet()) {
		reqBuilder_<%=cid%>.header(header_<%=cid%>.getKey(), header_<%=cid%>.getValue());
	}

	// Exécution de la requête HTTP
	java.net.http.HttpResponse<String> nativeResponse_<%=cid%> = nativeClient_<%=cid%>.send(
		reqBuilder_<%=cid%>.build(), 
		java.net.http.HttpResponse.BodyHandlers.ofString()
	);

	statusCode_<%=cid%> = nativeResponse_<%=cid%>.statusCode();
	restResponse_<%=cid%> = nativeResponse_<%=cid%>.body();

	if (statusCode_<%=cid%> >= 400) {
		globalMap.put("<%=cid%>_ERROR_MESSAGE", nativeResponse_<%=cid%>.body());
	}

} catch (Exception e) {
	globalMap.put("<%=cid%>_ERROR_MESSAGE", e.getMessage());
	throw e;
}

<% log.info(log.str("Has sent request to rest server.")); %>

// Affectation aux flux de sortie Talend
<%
List<? extends IConnection> conns = node.getOutgoingSortedConnections();
if (conns != null && conns.size() > 0) {
	IConnection conn = conns.get(0);
	if (conn.getLineStyle().hasConnectionCategory(IConnectionCategory.DATA)) {
		IMetadataTable metadata = conn.getMetadataTable();
		List<IMetadataColumn> columnList = metadata.getListColumns();
%>		
		<%=conn.getName() %> = new <%=conn.getName() %>Struct();
		<%=conn.getName() %>.ERROR_CODE = statusCode_<%=cid%>;
		if (statusCode_<%=cid%> != 204) {
			<%=conn.getName() %>.Body = restResponse_<%=cid%>;
		}
<%		
	}
}
%>

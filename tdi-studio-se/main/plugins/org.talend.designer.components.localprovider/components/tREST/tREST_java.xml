<COMPONENT>
	<HEADER
		PLATEFORM="ALL"
		SERIAL=""
		VERSION="0.102"
		STATUS="ALPHA"
		COMPATIBILITY="ALL"
		AUTHOR="Talaxie"
		RELEASE_DATE="20050320A"
		STARTABLE="true"
		LOG4J_ENABLED="true"
	>
		<SIGNATURE />
	</HEADER>

	<FAMILIES>
		<FAMILY>Internet</FAMILY>
	</FAMILIES>

	<DOCUMENTATION>
		<URL />
	</DOCUMENTATION>

	<CONNECTORS>
		<CONNECTOR CTYPE="FLOW" MAX_INPUT="0" MAX_OUTPUT="1"/>
		<CONNECTOR CTYPE="ITERATE" MAX_OUTPUT="1" MAX_INPUT="1" />
		<CONNECTOR CTYPE="SUBJOB_OK" MAX_INPUT="1" />
		<CONNECTOR CTYPE="SUBJOB_ERROR" MAX_INPUT="1" />
		<CONNECTOR CTYPE="COMPONENT_OK" />
		<CONNECTOR CTYPE="COMPONENT_ERROR" />
		<CONNECTOR CTYPE="RUN_IF" />
	</CONNECTORS>

	<PARAMETERS>
		<PARAMETER NAME="SCHEMA" FIELD="SCHEMA_TYPE" READONLY="true" REQUIRED="true" NUM_ROW="10">
			<TABLE READONLY="true">
				<COLUMN NAME="Body"	TYPE="id_String" READONLY="true" />
				<COLUMN NAME="ERROR_CODE" TYPE="id_Integer" READONLY="true" />
			</TABLE>
		</PARAMETER>

		<PARAMETER NAME="URL" FIELD="TEXT" REQUIRED="true" NUM_ROW="20">
			<DEFAULT>""</DEFAULT>
		</PARAMETER>

		<PARAMETER NAME="METHOD" FIELD="CLOSED_LIST" NUM_ROW="30">
			<ITEMS DEFAULT="GET">
				<ITEM NAME="GET" VALUE="GET" />
				<ITEM NAME="POST" VALUE="POST" />
				<ITEM NAME="PUT" VALUE="PUT" />
				<ITEM NAME="DELETE" VALUE="DELETE" />
			</ITEMS>
		</PARAMETER>

		<PARAMETER NAME="HEADERS" FIELD="TABLE" NUM_ROW="40" NB_LINES="6">
			<ITEMS>
				<ITEM NAME="NAME" VALUE='""'/>
				<ITEM NAME="VALUE" VALUE='""'/>
			</ITEMS>
		</PARAMETER>

		<PARAMETER NAME="BODY" FIELD="MEMO" NUM_ROW="50" NB_LINES="10" SHOW_IF="(METHOD=='POST') OR (METHOD=='PUT')">
			<DEFAULT>""</DEFAULT>
		</PARAMETER>

	</PARAMETERS>

	<ADVANCED_PARAMETERS/>

	<CODEGENERATION>
		<IMPORTS>
			<IMPORT NAME="jersey_client" MODULE="jersey-client-2.46.jar" MVN="mvn:org.glassfish.jersey.core/jersey-client/2.46" REQUIRED="true" />
			<IMPORT NAME="jersey-common" MODULE="jersey-common-2.46.jar" MVN="mvn:org.glassfish.jersey.core/jersey-common/2.46" REQUIRED="true" />
			<IMPORT NAME="javax.ws.rs-api" MODULE="javax.ws.rs-api-2.1.1.jar" MVN="mvn:javax.ws.rs/javax.ws.rs-api/2.1.1" REQUIRED="true" />
			<IMPORT NAME="jakarta.inject" MODULE="jakarta.inject-2.6.1.jar" MVN="mvn:org.glassfish.hk2.external/jakarta.inject/2.6.1" REQUIRED="true" />
			<IMPORT NAME="javax.annotation" MODULE="javax.annotation-api-1.3.2.jar" MVN="mvn:javax.annotation/javax.annotation-api/1.3.2" REQUIRED="true" />
			<IMPORT NAME="javax.activation-api" MODULE="javax.activation-api-1.2.0.jar" MVN="mvn:javax.activation/javax.activation-api/1.2.0" REQUIRED="true" />
			<IMPORT NAME="jersey-injectless-client" MODULE="jersey-injectless-client-2.46.jar" MVN="mvn:org.glassfish.jersey.incubator/jersey-injectless-client/2.46" REQUIRED="true" />
		</IMPORTS>
	</CODEGENERATION>

	<RETURNS/>

</COMPONENT>

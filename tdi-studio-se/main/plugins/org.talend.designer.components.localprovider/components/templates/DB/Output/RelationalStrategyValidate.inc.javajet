<% if ("RELATIONAL_STRATEGY".equals(dataAction)) { %>
    int relationalBatchLimit_<%=cid%> = <%=relationalBatchSize%>;
    if (relationalBatchLimit_<%=cid%> <= 0) throw new IllegalArgumentException("Relational strategy batch size must be positive");
<% } %>
<%
    if ("RELATIONAL_STRATEGY".equals(dataAction)
            && ("mysql".equals(relationalDb) || "oracle".equals(relationalDb))
            && "true".equals(ElementParameterParser.getValue(node,"__USE_EXISTING_CONNECTION__"))
            && java.util.Arrays.asList("CREATE", "CREATE_IF_NOT_EXISTS", "DROP_CREATE", "DROP_IF_EXISTS_AND_CREATE", "TRUNCATE", "TRUNCATE_REUSE_STORAGE")
                .contains(ElementParameterParser.getValue(node,"__TABLE_ACTION__"))) {
%>
    System.err.println("Warning: this table action may implicitly commit pending work on the shared MySQL/Oracle connection, including writes from other components. A later rollback cannot undo work already committed.");
<% } %>

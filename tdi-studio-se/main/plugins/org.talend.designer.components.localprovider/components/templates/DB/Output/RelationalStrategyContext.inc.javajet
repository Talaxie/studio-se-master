<%@ jet imports="org.talend.core.model.metadata.types.JavaTypesManager org.talend.core.model.process.IConnectionCategory java.util.List java.util.Map java.util.ArrayList" %>
<%
    CodeGeneratorArgument codeGenArgument = (CodeGeneratorArgument) argument;
    INode node = (INode) codeGenArgument.getArgument();
    String cid = node.getUniqueName();
    dbLog = new DBLogUtil(node);
    String dataAction = ElementParameterParser.getValue(node,"__DATA_ACTION__");
    String dbmsId = ElementParameterParser.getValue(node,"__MAPPING__");
    String commitEvery = ElementParameterParser.getValue(node,"__COMMIT_EVERY__");
    String dieOnError = ElementParameterParser.getValue(node,"__DIE_ON_ERROR__");
    boolean useExistingConnection = "true".equals(ElementParameterParser.getValue(node,"__USE_EXISTING_CONNECTION__"));
    boolean setAutoCommit = false;
    boolean isEnableDebug = "true".equals(ElementParameterParser.getValue(node,"__ENABLE_DEBUG_MODE__"));
    boolean whereSupportNull = "true".equals(ElementParameterParser.getValue(node,"__SUPPORT_NULL_WHERE__"));
    List<IMetadataColumn> columnList = node.getMetadataList().get(0).getListColumns();
    boolean useFieldOptions = false;
    List<Map<String,String>> addCols = null;
    String rejectConnName = null;
    List<IMetadataColumn> rejectColumnList = null;
    List<? extends IConnection> relationalRejects = node.getOutgoingConnections("REJECT");
    if (relationalRejects != null && !relationalRejects.isEmpty()) {
        rejectConnName = relationalRejects.get(0).getName();
        IMetadataTable relationalRejectMetadata = node.getMetadataFromConnector("REJECT");
        if (relationalRejectMetadata != null) rejectColumnList = relationalRejectMetadata.getListColumns();
    }
%>
<%@ include file="RelationalStrategyConfig.inc.javajet" %>

        namedWriter_<%=namedCid%>.finish();
        nb_line_<%=namedCid%> = namedWriter_<%=namedCid%>.inputs;
        insertedCount_<%=namedCid%> = namedWriter_<%=namedCid%>.inserted;
        updatedCount_<%=namedCid%> = namedWriter_<%=namedCid%>.updated;
        deletedCount_<%=namedCid%> = namedWriter_<%=namedCid%>.deleted;
        rejectedCount_<%=namedCid%> = namedWriter_<%=namedCid%>.rejected;
    }
    if(!conn_<%=namedCid%>.getAutoCommit()) conn_<%=namedCid%>.commit();
} catch(java.sql.SQLException namedFinishError_<%=namedCid%>) {
    if(namedWriter_<%=namedCid%> != null) namedWriter_<%=namedCid%>.abort(namedFinishError_<%=namedCid%>);

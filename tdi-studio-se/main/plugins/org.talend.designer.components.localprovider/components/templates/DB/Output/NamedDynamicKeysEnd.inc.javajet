<%@ include file="NamedDynamicKeysContext.inc.javajet" %>
routines.system.DynamicDml namedWriter_<%=namedCid%> = (routines.system.DynamicDml)resourceMap.remove("namedDynamicKeys_<%=namedCid%>");
try {

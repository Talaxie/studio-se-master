<%
if ("RELATIONAL_STRATEGY".equals(dataAction) && relationalBatchUse) {
%>
    if (conn_<%=cid%>.getAutoCommit()) {
<% if ("true".equals(ElementParameterParser.getValue(node,"__USE_EXISTING_CONNECTION__"))) { %>
        throw new java.sql.SQLException("Relational strategy batches require an existing connection with autocommit disabled");
<% } else { %>
        conn_<%=cid%>.setAutoCommit(false);
<% } %>
    }
<% } %>

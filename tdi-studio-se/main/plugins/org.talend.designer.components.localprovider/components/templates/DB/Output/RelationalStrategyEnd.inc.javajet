<%@ include file="RelationalStrategyContext.inc.javajet" %>
    try {
        relationalBatch_<%=cid%>.flush();
<% if (!useExistingConnection && (relationalBatchUse || (!"".equals(commitEvery) && !"0".equals(commitEvery)))) { %>
        conn_<%=cid%>.commit();
        relationalBatch_<%=cid%>.committed();
<% } %>
        relationalBatch_<%=cid%>.finished=true;
    } catch (java.sql.SQLException relationalEndError_<%=cid%>) {
        globalMap.put("<%=cid%>_ERROR_MESSAGE", relationalEndError_<%=cid%>.getMessage());
        relationalBatch_<%=cid%>.fail(relationalEndError_<%=cid%>);
        throw relationalEndError_<%=cid%>;
    }
    insertedCount_<%=cid%>=relationalBatch_<%=cid%>.inserted;
    updatedCount_<%=cid%>=relationalBatch_<%=cid%>.updated;
    deletedCount_<%=cid%>=relationalBatch_<%=cid%>.deleted;
    globalMap.put("<%=cid%>_NB_LINE_BATCH_UNKNOWN", relationalBatch_<%=cid%>.unknown);
    relationalBatch_<%=cid%>.close();
    resourceMap.remove("relationalBatch_<%=cid%>");
    resourceMap.remove("pstmtInsert_<%=cid%>");
    resourceMap.remove("pstmtUpdate_<%=cid%>");
    resourceMap.remove("pstmt_<%=cid%>");
    resourceMap.put("statementClosed_<%=cid%>", true);
<% if (!useExistingConnection) { %>
    resourceMap.put("finish_<%=cid%>", true);
<% } %>
<%@ include file="DBOutputEndGlobalVars.javajet" %>
